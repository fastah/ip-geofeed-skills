#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

step() {
  printf '\n[%(%H:%M:%S)T] %s\n' -1 "$1"
}

step "Checking system packages"
missing_packages=()
for command_package in \
  "curl:curl" \
  "jq:jq" \
  "make:make" \
  "python3:python3" \
  "rsync:rsync"; do
  command_name="${command_package%%:*}"
  package_name="${command_package#*:}"
  if ! command -v "$command_name" >/dev/null 2>&1; then
    missing_packages+=("$package_name")
  fi
done

if ((${#missing_packages[@]})); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates "${missing_packages[@]}"
else
  echo "System packages are already installed."
fi

step "Checking Go toolchain"
go_version="1.26.6"
minimum_go_version="1.21"
installed_go_version=""
if command -v go >/dev/null 2>&1; then
  installed_go_version="$(go env GOVERSION | sed 's/^go//')"
fi

if [[ -z "$installed_go_version" || "$(printf '%s\n%s\n' "$minimum_go_version" "$installed_go_version" | sort -V | head -n1)" != "$minimum_go_version" ]]; then
  case "$(uname -m)" in
    x86_64)
      go_arch="amd64"
      go_sha256="708effb774be8237570d0add163225abbdfaf4fca28b2611df167beba4feef89"
      ;;
    aarch64|arm64)
      go_arch="arm64"
      go_sha256="d0507e9e9d7fe012aae570108cbd76c15de879e17130ab8cb90d4d7445cb1f2e"
      ;;
    *)
      echo "Unsupported architecture: $(uname -m)" >&2
      exit 1
      ;;
  esac

  go_install_dir="/usr/local/lib/go${go_version}"
  if [[ ! -x "$go_install_dir/bin/go" ]]; then
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT
    archive="$tmp_dir/go.tar.gz"
    curl -fsSL "https://go.dev/dl/go${go_version}.linux-${go_arch}.tar.gz" -o "$archive"
    echo "$go_sha256  $archive" | sha256sum --check --status
    tar -C "$tmp_dir" -xzf "$archive"
    sudo install -d /usr/local/lib
    sudo mv "$tmp_dir/go" "$go_install_dir"
  fi
  sudo ln -sfn "$go_install_dir/bin/go" /usr/local/bin/go
  sudo ln -sfn "$go_install_dir/bin/gofmt" /usr/local/bin/gofmt
  installed_go_version="$(go env GOVERSION | sed 's/^go//')"
fi
echo "Go $installed_go_version is available."

step "Downloading Go module dependencies"
(cd "$repo_root/experimental/ip-geofeed" && go mod download)

step "Setup complete"
